# Copy to .env at the monorepo root and fill in locally. Never commit .env or real token values.
# bot-server loads this file even when cwd is apps/bot-server.
TELEGRAM_BOT_TOKEN=
# Alternate name (e.g. Cursor secret TELEGRAM_BOT_TOKEN_MQ) — used if TELEGRAM_BOT_TOKEN is empty:
# TELEGRAM_BOT_TOKEN_MQ=

# bot-server HTTP API (progress / auth stub for Mini App)
HTTP_PORT=8787
CORS_ORIGIN=*
# Optional public Mini App URL shown by /single
MINIAPP_URL=

# telegram-miniapp / web (Vite) — points at the HTTP API
VITE_API_BASE_URL=http://127.0.0.1:8787

# Championship open days of month (UTC), comma-separated, or * for all (stub default)
CHAMPIONSHIP_OPEN_DAYS=*

