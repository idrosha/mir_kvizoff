{
  "name": "@mir-games/bot-server",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot-server for Мир Квизов (auth, economy confirmation, game ports)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @mir-games/game-core && node --import tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@mir-games/game-core": "0.1.0",
    "dotenv": "^18.0.9",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
