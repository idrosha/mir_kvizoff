{
  "name": "@mir-games/game-core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-free quiz rules for Мир Квизов",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @mir-games/platform-contracts && node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@mir-games/platform-contracts": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
