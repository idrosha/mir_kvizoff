{
  "name": "@mir-games/adapters-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor / Android mobile adapters (haptics + Play Billing stubs) for Мир Квизов",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mir-games/adapters-web": "0.1.0",
    "@mir-games/game-core": "0.1.0",
    "@mir-games/platform-contracts": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
